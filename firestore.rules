rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /treeMemberships/{treeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /trees/{treeId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /branches/{branchId} {
        allow read: if request.auth != null;
        allow write: if false;

        match /posts/{postId} {
          allow read: if request.auth != null &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid)/treeMemberships/$(treeId)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)/treeMemberships/$(treeId)).data.branchId == branchId;

          allow create: if request.auth != null &&
            request.resource.data.uploaderUid == request.auth.uid &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid)/treeMemberships/$(treeId));

          allow update, delete: if request.auth != null &&
            resource.data.uploaderUid == request.auth.uid;
        }
      }
    }

    match /inviteTokens/{token} {
      allow read, write: if false;
    }
  }
}